<Window x:Class="SOM_Kohonen_WpfApp.Views.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Порівняння решіток SOM" Width="1180" Height="820" MinWidth="900" MinHeight="650"
        Background="WhiteSmoke" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/><Setter Property="MinWidth" Value="75"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,6"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ProgressText" Text="Налаштуйте серію та перевірте фактичний список seed." Margin="4" TextWrapping="Wrap"/>
            <ProgressBar x:Name="TotalProgress" Height="12" Margin="4"/>
            <TextBlock x:Name="IterationText" Margin="4"/>
            <ProgressBar x:Name="IterationProgress" Height="7" Margin="4"/>
            <WrapPanel>
                <Button x:Name="StartButton" Content="Запустити серію" Click="Start_Click"/>
                <Button x:Name="CancelButton" Content="Скасувати" IsEnabled="False" Click="Cancel_Click"/>
                <Button x:Name="ExportButton" Content="Експорт у CSV" IsEnabled="False" Click="Export_Click"/>
                <Button x:Name="AssignmentsButton" Content="Експорт призначень абонентів" IsEnabled="False" Click="Assignments_Click"/>
            </WrapPanel>
        </StackPanel>
        <TabControl x:Name="Tabs">
            <TabItem Header="Налаштування">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsPanel" Margin="10">
                        <WrapPanel><Button Content="Імпорт JSON…" Click="Import_Click"/><TextBlock x:Name="DatasetText" Text="Набір даних не вибрано" TextWrapping="Wrap"/></WrapPanel>
                        <TextBlock Text="Числові ознаки (лише скінченні числа в усіх рядках). Ідентифікатор виключається автоматично." Margin="4"/>
                        <DataGrid x:Name="FeaturesGrid" Height="170" AutoGenerateColumns="False" FontSize="14" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Навчати" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Ознака" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8">
                            <TextBlock Text="ID абонента"/><ComboBox x:Name="IdColumn" Width="220" SelectionChanged="Id_Changed"/>
                            <TextBlock Text="Нормалізація"/><ComboBox x:Name="Normalization" Width="220" SelectedIndex="1">
                                <ComboBoxItem Content="Без нормалізації"/><ComboBoxItem Content="Min–max [0; 1]"/><ComboBoxItem Content="Z-score (σ генеральної сукупності)"/>
                            </ComboBox>
                        </WrapPanel>
                        <GroupBox Header="Спільні параметри SOM" Padding="8">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Ширина"/><TextBox x:Name="MapWidth" Text="24"/>
                                    <TextBlock Text="Висота"/><TextBox x:Name="MapHeight" Text="18"/>
                                    <TextBlock Text="Ітерації"/><TextBox x:Name="Iterations" Text="100"/>
                                    <TextBlock Text="Швидкість навчання"/><TextBox x:Name="LearningRate" Text="0.03"/>
                                    <TextBlock Text="Початковий радіус"/><TextBox x:Name="Radius" Text="12"/>
                                </WrapPanel>
                                <TextBlock Text="Ітерація = повний прохід вибірки. Метрика: евклідова. Сусідство: гаусове в межах радіуса. Швидкість і радіус спадають експоненційно. Карти без замикання країв." TextWrapping="Wrap" Margin="4"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Парні запуски" Padding="8" Margin="0,8">
                            <StackPanel>
                                <WrapPanel>
                                    <ComboBox x:Name="SeedMode" Width="225" SelectedIndex="0" SelectionChanged="Seeds_Changed">
                                        <ComboBoxItem Content="Автоматично з базового seed"/><ComboBoxItem Content="Власний список seed"/>
                                    </ComboBox>
                                    <TextBlock Text="Кількість пар запусків"/><TextBox x:Name="PairCount" Text="10" TextChanged="Seeds_Changed"/>
                                    <TextBlock Text="Базовий seed"/><TextBox x:Name="BaseSeed" Text="42" TextChanged="Seeds_Changed"/>
                                    <TextBlock x:Name="TrainingCount" Margin="8" FontWeight="Bold"/>
                                </WrapPanel>
                                <TextBox x:Name="CustomSeeds" Text="11, 29" TextChanged="Seeds_Changed" AcceptsReturn="True" Height="55" VerticalScrollBarVisibility="Auto" ToolTip="Цілі seed через кому, пробіл або новий рядок"/>
                                <TextBlock Text="Фактичні seed:" Margin="4"/>
                                <TextBox x:Name="SeedPreview" IsReadOnly="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="SeedError" Foreground="Firebrick" TextWrapping="Wrap" Margin="4"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="k-means ваг усіх нейронів" Padding="8">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="k"/><TextBox x:Name="ClusterCount" Text="4"/>
                                    <TextBlock Text="Seed k-means"/><TextBox x:Name="KMeansSeed" Text="42"/>
                                    <TextBlock Text="Максимум ітерацій"/><TextBox x:Name="KMeansIterations" Text="100"/>
                                </WrapPanel>
                                <TextBlock Text="Одна ініціалізація (підтримується наявним k-means). Однакові параметри для всіх карт." Margin="4"/>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock Text="Силует обчислюється точно для всіх абонентів у спільному нормалізованому просторі; час розрахунку зростає квадратично з кількістю рядків. ID мають бути непорожніми й унікальними; без колонки ID використовується номер вихідного рядка." TextWrapping="Wrap" Margin="4,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Результати за seed"><DataGrid x:Name="SeedResults" AutoGenerateColumns="True" IsReadOnly="True" FontSize="14"/></TabItem>
            <TabItem Header="Зведення"><DataGrid x:Name="SummaryResults" AutoGenerateColumns="True" IsReadOnly="True" FontSize="14"/></TabItem>
            <TabItem Header="Попарні ARI"><DataGrid x:Name="AriResults" AutoGenerateColumns="True" IsReadOnly="True" FontSize="14"/></TabItem>
            <TabItem Header="Зіставлені профілі">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel><TextBlock Text="Seed повної пари" Margin="8"/><ComboBox x:Name="ProfileSeed" Width="180" SelectionChanged="ProfileSeed_Changed"/></WrapPanel>
                        <TextBlock x:Name="ProfileHint" Text="Оберіть завершену пару. Середні значення — у вихідних одиницях, частки — від 0 до 1." Margin="8"/>
                    </StackPanel>
                    <DataGrid x:Name="MatchedResults" AutoGenerateColumns="True" IsReadOnly="True" FontSize="14"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Усі профілі"><DataGrid x:Name="AllProfiles" AutoGenerateColumns="True" IsReadOnly="True" FontSize="14"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>
